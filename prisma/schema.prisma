generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Block {
  height           BigInt             @id
  parentHash       String             @map("parent_hash")
  stateRoot        String             @map("state_root")
  blockHash        String             @unique @map("block_hash")
  transactionCount Int                @map("transaction_count")
  rawBlock         Json               @map("raw_block")
  transactions     ChainTransaction[]

  @@map("blocks")
}

model ChainTransaction {
  hash            String  @id
  blockHeight     BigInt? @map("block_height")
  transactionIndex Int    @map("transaction_index")
  fromAddress     String  @map("from_address")
  toAddress       String  @map("to_address")
  amount          BigInt
  nonce           BigInt
  publicKeyBase64 String  @map("public_key_base64")
  signatureBase64 String  @map("signature_base64")
  rawTransfer     Json    @map("raw_transfer")
  block           Block?  @relation(fields: [blockHeight], references: [height], onDelete: Cascade)
  rollupBatches   RollupBatchTransaction[]

  @@index([blockHeight])
  @@index([fromAddress])
  @@index([toAddress])
  @@map("transactions")
}

model TransactionPoolEntry {
  id                       BigInt   @id @default(autoincrement())
  hash                     String   @unique
  fromAddress              String   @map("from_address")
  toAddress                String   @map("to_address")
  amount                   BigInt
  nonce                    BigInt
  publicKeyBase64          String   @map("public_key_base64")
  signatureBase64          String   @map("signature_base64")
  status                   String
  failureReason            String?  @map("failure_reason")
  includedBlockHeight      BigInt?  @map("included_block_height")
  includedTransactionIndex Int?     @map("included_transaction_index")
  rawTransfer              Json     @map("raw_transfer")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @map("updated_at")

  @@index([status, id])
  @@index([fromAddress, nonce])
  @@index([createdAt])
  @@map("transaction_pool")
}

model Account {
  address String @id
  balance BigInt
  nonce   BigInt

  @@map("accounts")
}

model IndexerCheckpoint {
  id                String  @id
  lastIndexedHeight BigInt? @map("last_indexed_height")

  @@map("indexer_checkpoints")
}

model ErrorEvent {
  id         BigInt    @id @default(autoincrement())
  service    String
  severity   String
  message    String
  context    Json      @default("{}")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_events")
}

model RollupBatch {
  batchNumber     BigInt                    @id @map("batch_number")
  startBlockHeight BigInt                   @map("start_block_height")
  endBlockHeight   BigInt                   @map("end_block_height")
  prevStateRoot   String                    @map("prev_state_root")
  newStateRoot    String                    @map("new_state_root")
  transactionRoot String                    @map("transaction_root")
  blockHashRoot   String                    @map("block_hash_root")
  dataHash        String                    @unique @map("data_hash")
  transactionCount Int                      @map("transaction_count")
  status          String
  l1ChainId       BigInt?                   @map("l1_chain_id")
  l1ContractAddress String?                 @map("l1_contract_address")
  l1SubmitTxHash  String?                   @map("l1_submit_tx_hash")
  l1SubmittedAt   DateTime?                 @map("l1_submitted_at")
  l1SubmitBlockNumber BigInt?               @map("l1_submit_block_number")
  l1SubmitGasUsed BigInt?                   @map("l1_submit_gas_used")
  l1SubmitReceipt Json?                     @map("l1_submit_receipt")
  l1FinalizeTxHash String?                  @map("l1_finalize_tx_hash")
  l1FinalizedAt   DateTime?                 @map("l1_finalized_at")
  l1FinalizeBlockNumber BigInt?             @map("l1_finalize_block_number")
  l1FinalizeGasUsed BigInt?                 @map("l1_finalize_gas_used")
  l1FinalizeReceipt Json?                   @map("l1_finalize_receipt")
  rawCommitment   Json                      @map("raw_commitment")
  validityWitness Json?                     @map("validity_witness")
  transactions    RollupBatchTransaction[]

  @@index([startBlockHeight])
  @@index([endBlockHeight])
  @@map("rollup_batches")
}

model RollupBatchTransaction {
  batchNumber      BigInt           @map("batch_number")
  transactionHash  String           @map("transaction_hash")
  blockHeight      BigInt           @map("block_height")
  transactionIndex Int              @map("transaction_index")
  batch            RollupBatch      @relation(fields: [batchNumber], references: [batchNumber], onDelete: Cascade)
  transaction      ChainTransaction @relation(fields: [transactionHash], references: [hash], onDelete: Cascade)

  @@id([batchNumber, transactionHash])
  @@index([transactionHash])
  @@index([blockHeight])
  @@map("rollup_batch_transactions")
}
