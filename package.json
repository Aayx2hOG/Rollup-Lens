{
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bunx prisma migrate dev",
    "genesis:init": "cargo run -p explorer-api -- --initialize-genesis",
    "api:dev": "cargo run -p explorer-api -- --bind 127.0.0.1:3000",
    "ui:dev": "bun run --cwd apps/explorer-ui dev",
    "dev": "bun run ui:dev"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
