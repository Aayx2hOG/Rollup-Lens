{
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bunx prisma migrate dev",
    "api:dev": "cargo run -p explorer-api -- --bind 127.0.0.1:3000",
    "ui:dev": "bun --cwd apps/explorer-ui run dev",
    "dev": "sh -c 'trap \"kill 0\" EXIT; bun run api:dev & bun run ui:dev'"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
